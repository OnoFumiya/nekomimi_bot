<?xml version="1.0" encoding="UTF-8" ?>
<robot name="nekomimi_bot"
       xmlns:xacro="http://ros.org/wiki/xacro" >
  <xacro:macro name="body_plate" params="prefix parent">

    <joint name="${prefix}_joint" type="fixed">
      <origin xyz="0.0 0.0 0.035" rpy="0.0 0.0 0.0" />
      <parent link="${parent}" />
      <child link="${prefix}_link" />
    </joint>

    <link name="${prefix}_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find nekomimi_bot_description)/meshes/body/body_plate.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.1 0.1 0.1" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <mass value="1.0" />
        <inertia ixx="0.083" ixy="0.0" ixz="0.0"
                 iyy="0.083" iyz="0.0"
                 izz="0.001" />
      </inertial>
    </link>

    <joint name="${prefix}_cover_joint" type="fixed">
      <origin xyz="0.0 0.0 0.035" rpy="0.0 0.0 0.0" />
      <parent link="${parent}" />
      <child link="${prefix}_cover_link" />
    </joint>

    <link name="${prefix}_cover_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find nekomimi_bot_description)/meshes/body/body_cover.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.1 0.1 0.1" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <mass value="1.0" />
        <inertia ixx="0.083" ixy="0.0" ixz="0.0"
                 iyy="0.083" iyz="0.0"
                 izz="0.001" />
      </inertial>
    </link>
  </xacro:macro>
</robot>
