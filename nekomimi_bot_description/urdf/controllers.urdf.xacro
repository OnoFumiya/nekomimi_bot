<?xml version="1.0" encoding="UTF-8" ?>
<robot name="nekomimi_bot_controllers" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="controllers" params="name enable_gz:=False robot_name:=nekomimi_bot">

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${$(arg enable_gz)}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="${$(arg enable_gz)}">
          <xacro:property name="ftc_sl_port" value="$(arg ftc_sl_port)"/>
          <plugin>feetech_ros2_driver/FeetechHardwareInterface</plugin>
          <param name="usb_port">${ftc_sl_port}</param>
        </xacro:unless>
      </hardware>

      <!-- Position Drive - Body -->
      <joint name="body_roll_joint">
        <xacro:unless value="${$(arg enable_gz)}">
          <param name="initial_position">0.0</param>
          <param name="id">21</param>
          <param name="p_cofficient">8</param>
          <param name="offset">2048</param>
          <param name="counter_rotation">0</param>
        </xacro:unless>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Position Drive: Hand -->

      <!-- Position Drive: Head -->
      <joint name="head_pan_joint">
        <xacro:unless value="${$(arg enable_gz)}">
          <param name="initial_position">0.0</param>
          <param name="id">31</param>
          <param name="p_cofficient">8</param>
          <param name="offset">2048</param>
          <param name="counter_rotation">1</param>
        </xacro:unless>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="head_tilt_joint">
        <xacro:unless value="${$(arg enable_gz)}">
          <param name="initial_position">0.0</param>
          <param name="id">32</param>
          <param name="p_cofficient">8</param>
          <param name="offset">2048</param>
          <param name="counter_rotation">1</param>
        </xacro:unless>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Position Drive: Wheels -->
      <joint name="left_wheel_joint">
        <xacro:unless value="${$(arg enable_gz)}">
          <param name="initial_position">0.0</param>
          <param name="id">11</param>
          <!-- <param name="p_cofficient">8</param> -->
          <!-- <param name="offset">2048</param> -->
          <param name="counter_rotation">1</param>
        </xacro:unless>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_wheel_joint">
        <xacro:unless value="${$(arg enable_gz)}">
          <param name="initial_position">0.0</param>
          <param name="id">12</param>
          <!-- <param name="p_cofficient">8</param> -->
          <!-- <param name="offset">2048</param> -->
          <param name="counter_rotation">0</param>
        </xacro:unless>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>



    <!-- Ignition ROS2 Control -->
    <xacro:if value="${$(arg enable_gz)}">
      <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <ros>
            <namespace>${robot_name}</namespace>
          </ros>
          <parameters>$(find nekomimi_bot_bringup)/config/controllers.yaml</parameters>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>
