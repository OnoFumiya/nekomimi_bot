<?xml version="1.0" encoding="UTF-8" ?>
<robot name="nekomimi_bot"
       xmlns:xacro="http://ros.org/wiki/xacro" >
  <xacro:macro name="head_base" params="prefix parent">

    <joint name="${prefix}_joint" type="fixed">
      <origin xyz="0.0 0.0 0.1599" rpy="0.0 0.0 0.0" />
      <parent link="${parent}" />
      <child link="${prefix}_link" />
    </joint>

    <link name="${prefix}_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find nekomimi_bot_description)/meshes/head/head_base.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="-0.00529 0.0 0.035" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.032 0.021 0.069" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <mass value="1.0" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" 
                 iyy="0.001" iyz="0.0" 
                 izz="0.001"/>
      </inertial>
    </link>
  </xacro:macro>


  <xacro:macro name="head_pan" params="prefix parent">

    <joint name="${prefix}_joint" type="revolute">
      <origin xyz="0.0 0.0 0.0454" rpy="0.0 0.0 0.0" />
      <parent link="${parent}" />
      <child link="${prefix}_link" />
      <axis xyz="0.0 0.0 1.0 " />
      <limit lower="${-M_PI/2}" upper="${M_PI/2}" effort="4.1" velocity="4.796165" />
    </joint>

    <link name="${prefix}_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find nekomimi_bot_description)/meshes/head/head_tilt_base.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="black" />
      </visual>
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <mass value="1.0" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" 
                 iyy="0.001" iyz="0.0" 
                 izz="0.001"/>
      </inertial>
    </link>
  </xacro:macro>


  <xacro:macro name="head_tilt" params="prefix parent">

    <joint name="${prefix}_joint" type="revolute">
      <origin xyz="0.0 0.0 0.01975" rpy="0.0 0.0 0.0" />
      <parent link="${parent}" />
      <child link="${prefix}_link" />
      <axis xyz="0.0 1.0 0.0 " />
      <limit lower="${-M_PI/2}" upper="${M_PI/2}" effort="4.1" velocity="4.796165" />
    </joint>

    <link name="${prefix}_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find nekomimi_bot_description)/meshes/head/camera_base.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="black" />
      </visual>
    </link>
  </xacro:macro>


  <xacro:macro name="head" params="parent prefix">
    <xacro:head_base parent="${parent}_link" prefix="${prefix}" />
    <xacro:head_pan  parent="${prefix}_link" prefix="${prefix}_pan" />
    <xacro:head_tilt parent="${prefix}_pan_link" prefix="${prefix}_tilt" />
  </xacro:macro>
</robot>
