<?xml version="1.0" encoding="UTF-8" ?>
<robot name="nekomimi_bot"
       xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="wheel_base" params="parent prefix pose_yaw axis_y">

    <joint name="${prefix}_joint" type="continuous">
      <origin xyz="0.0 ${axis_y*0.0725} -0.01" rpy="0.0 0.0 0.0" />
      <parent link="${parent}" />
      <child link="${prefix}_link" />
      <axis xyz="0.0 1.0 0.0 " />
      <limit effort="10.0" velocity="15.913672" />
    </joint>

    <link name="${prefix}_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${pose_yaw}" />
        <geometry>
          <mesh filename="package://nekomimi_bot_description/meshes/mobile_base/wheel.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="wheel" />
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="${axis_y*M_PI/2} 0.0 0.0" />
        <geometry>
          <cylinder radius="0.025" length="0.01"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <mass value="1.0" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" 
                 iyy="0.001" iyz="0.0" 
                 izz="0.001"/>
      </inertial>
    </link>

  </xacro:macro>


  <xacro:macro name="wheel" params="parent prefix">
    <xacro:wheel_base parent="${parent}_link" prefix="left_${prefix}"  pose_yaw="${M_PI/2}"  axis_y="1.0"  />
    <xacro:wheel_base parent="${parent}_link" prefix="right_${prefix}" pose_yaw="${-M_PI/2}" axis_y="-1.0" />
  </xacro:macro>

</robot>
