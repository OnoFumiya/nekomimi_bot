<?xml version="1.0" encoding="UTF-8" ?>
<robot name="nekomimi_bot"
       xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="body_roll" params="parent prefix">

    <joint name="${prefix}_joint" type="revolute">
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <parent link="${parent}_link" />
      <child link="${prefix}_link" />
      <axis xyz="0.0 0.0 1.0 " />
      <limit lower="${-M_PI/2}" upper="${M_PI/2}" effort="4.1" velocity="4.796165" />
    </joint>

    <link name="${prefix}_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${M_PI/2}" />
        <geometry>
          <mesh filename="package://nekomimi_bot_description/meshes/mobile_base/wheel_controller_core.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="0.062 0.0 -0.02" rpy="0.0 0.0 0.0" />
        <geometry>
          <sphere radius="0.0146"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="-0.062 0.0 -0.02" rpy="0.0 0.0 0.0" />
        <geometry>
          <sphere radius="0.0146"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        <mass value="1.0" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" 
                 iyy="0.001" iyz="0.0" 
                 izz="0.001"/>
      </inertial>
    </link>

  </xacro:macro>
</robot>
